# Copia a .env y reemplaza los valores. Nunca subas .env al repositorio.
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://aicc:change_me@127.0.0.1:5432/aicc
REDIS_URL=redis://127.0.0.1:6379/0
APP_ENV=development
# Mínimo 32 caracteres aleatorios: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_value_of_at_least_32_chars
